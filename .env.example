# ──────────────────────────────────────────────────────────────
# .env.example — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────────

# ── Jira Integration ─────────────────────────────────────────
JIRA_DOMAIN=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJ

# ── AI Model (Planner + Generator Agents) ────────────────────
# Provide at least one. The system will use whichever is configured.
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
AI_MODEL_PROVIDER=openai
# Options: "openai" | "gemini"

# ── Distributed Redis Cache & LangSmith Observability ────────
REDIS_URL=redis://localhost:6379
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=toptal-qa-multi-agent-framework

# ── BrowserStack ─────────────────────────────────────────────
BROWSERSTACK_USERNAME=your_username
BROWSERSTACK_ACCESS_KEY=your_access_key

# ── AWS Device Farm ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_DEVICE_FARM_PROJECT_ARN=arn:aws:devicefarm:us-west-2:123456789:project/abc

# ── Test Environment ─────────────────────────────────────────
ENVIRONMENT=prod
BASE_URL=https://tutorialsninja.com/demo/
EXECUTION_TARGET=local
# Options: "local" | "cross-browser" | "mobile-web" | "browserstack" | "aws"

# ── Mobile App Paths ─────────────────────────────────────────
ANDROID_APP_PATH=./apps/app-debug.apk
IOS_APP_PATH=./apps/App.ipa
ANDROID_DEVICE=Pixel_7_API_34
ANDROID_VERSION=14
IOS_DEVICE=iPhone 15 Pro
IOS_VERSION=17.4
MOBILE_TARGET=local
# Options: "local" | "browserstack" | "aws"

# ── Test Credentials (optional overrides) ────────────────────
TEST_USERNAME=Abhishek Kumar
TEST_PASSWORD=Password123!
