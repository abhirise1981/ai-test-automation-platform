{
  "name": "toptal-project-assessment",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:cross-browser": "EXECUTION_TARGET=cross-browser playwright test",
    "test:mobile-web": "EXECUTION_TARGET=mobile-web playwright test",
    "test:browserstack": "EXECUTION_TARGET=browserstack playwright test",
    "test:aws": "EXECUTION_TARGET=aws playwright test",
    "test:mobile": "wdio run wdio.conf.ts",
    "test:mobile:android": "wdio run wdio.conf.ts --suite android",
    "test:mobile:ios": "wdio run wdio.conf.ts --suite ios",
    "test:mobile:browserstack": "MOBILE_TARGET=browserstack wdio run wdio.conf.ts",
    "test:all": "npm run test && npm run test:mobile",
    "appium:start": "appium --relaxed-security",
    "install:browsers": "npx playwright install",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write '**/*.ts'",
    "format:check": "prettier --check '**/*.ts'",
    "mcp:start": "npx ts-node mcp-server/server.ts",
    "agent:pipeline": "npx ts-node agents/pipeline.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "jira.js": "^4.0.0",
    "openai": "^4.70.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@gatling.io/cli": "^3.15.103",
    "@gatling.io/core": "^3.15.103",
    "@gatling.io/http": "^3.15.103",
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^2.12.0",
    "appium-uiautomator2-driver": "^3.8.0",
    "appium-xcuitest-driver": "^7.30.0",
    "browserstack-node-sdk": "^1.30.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.0",
    "lint-staged": "^15.3.0",
    "monocart-reporter": "^2.12.2",
    "prettier": "^3.4.0",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
