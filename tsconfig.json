{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Node16",
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test", "mocha", "webdriverio", "@wdio/globals/types"],
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "screens/**/*.ts",
    "api/**/*.ts",
    "config/**/*.ts",
    "agents/**/*.ts",
    "mcp-server/**/*.ts",
    "playwright.config.ts",
    "wdio.conf.ts"
  ],
  "exclude": ["node_modules", "dist", "target", "apps"]
}
